{
  "name": "stargate",
  "private": true,
  "type": "module",
  "bin": {
    "gpuctl": "./cli.mjs"
  },
  "scripts": {
    "build": "npm run build:vendor && npm run build:client",
    "build:native": "node scripts/build-campus-native.mjs",
    "build:release": "npm run build:native && npm run build",
    "build:vendor": "node scripts/build-frontend-vendor.mjs",
    "build:client": "node scripts/build-client.mjs",
    "test": "node scripts/test-entry.mjs node",
    "test:ui": "node scripts/test-entry.mjs ui",
    "test:all": "node scripts/test-entry.mjs all",
    "start": "node portal-server.mjs",
    "cli": "node cli.mjs",
    "precli": "npm run build:client",
    "test:python": "python3 scripts/test-python.py",
    "build:gpuq": "python3 scripts/build-gpuq.py"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.5",
    "@grpc/proto-loader": "0.8.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "qrcode": "1.5.4"
  },
  "version": "0.5.0",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.62.1"
  }
}
