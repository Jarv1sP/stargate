#!/usr/bin/python3
"""Opt-in network checks/process proxy inside an existing project OCI container.

No background traffic, host configuration, certificate bypass, or persisted
credentials. The caller chooses the target; no AI provider is probed by default.
"""
import argparse
import json
import os
from pathlib import Path
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

PROXY_KEYS = ('http_proxy','https_proxy','all_proxy','HTTP_PROXY','HTTPS_PROXY','ALL_PROXY')


class SafeParser(argparse.ArgumentParser):
    def error(self, message):
        self.exit(2,'gpuq-network: invalid arguments; run --help (values hidden)\n')


class NoDowngrade(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if urllib.parse.urlsplit(req.full_url).scheme=='https' and urllib.parse.urlsplit(newurl).scheme!='https':
            raise ValueError('Refusing HTTPS downgrade')
        return super().redirect_request(req,fp,code,msg,headers,newurl)


def url(value, proxy=False):
    parsed = urllib.parse.urlsplit(value)
    if parsed.scheme not in ('http','https') or not parsed.hostname or any(c.isspace() for c in value):
        raise ValueError('Use an explicit http:// or https:// URL')
    if not proxy and (parsed.username is not None or parsed.password is not None):
        raise ValueError('Diagnostic target URLs must not contain credentials')
    if proxy and (parsed.path not in ('','/') or parsed.query or parsed.fragment):
        raise ValueError('Proxy URL must contain only scheme, host, port and optional credentials')
    _ = parsed.port
    return parsed


def proxy_environment(value, environ):
    url(value, proxy=True)
    result = {k:v for k,v in environ.items() if k not in (*PROXY_KEYS,'no_proxy','NO_PROXY')}
    result.update({'HTTP_PROXY':value,'HTTPS_PROXY':value,'http_proxy':value,'https_proxy':value,
                   'NO_PROXY':'localhost,127.0.0.1,::1','no_proxy':'localhost,127.0.0.1,::1'})
    return result


def inspect(environ):
    return {'proxyConfigured':{k:bool(environ.get(k)) for k in PROXY_KEYS},
            'proxyCredentialsHidden':True, 'home':environ.get('HOME'),
            'project':environ.get('GPUQ_PROJECT'),
            'note':'Inside-job localhost is not the host. Proxy applies only to this process and its children.'}


def check(value):
    parsed = url(value)
    # Avoid echoing signed query strings, userinfo, HTTP headers, or body.
    result = {'target':parsed.scheme+'://'+parsed.hostname, 'dns':{}, 'http':{}}
    start = time.monotonic()
    try:
        addresses = socket.getaddrinfo(parsed.hostname, parsed.port or (443 if parsed.scheme=='https' else 80), type=socket.SOCK_STREAM)
        result['dns'] = {'ok':True,'addresses':sorted({a[4][0] for a in addresses})}
    except OSError as error:
        result['dns'] = {'ok':False,'errorType':type(error).__name__,'errno':error.errno}
    request = urllib.request.Request(value, method='HEAD', headers={'User-Agent':'gpuq-network/1'})
    # The subprocess deadline also bounds system resolver and redirect handling.
    try:
        with urllib.request.build_opener(NoDowngrade()).open(request, timeout=6) as response:
            result['http'] = {'reachable':True,'status':response.status,'finalScheme':urllib.parse.urlsplit(response.url).scheme}
    except urllib.error.HTTPError as error:
        result['http'] = {'reachable':error.code!=407,'status':error.code}
        if error.code==407: result['http']['proxyAuthRequired']=True
    except Exception as error:
        reason = getattr(error,'reason',error)
        result['http'] = {'reachable':False,'errorType':type(reason).__name__,'errno':getattr(reason,'errno',None)}
    result['elapsedSeconds'] = round(time.monotonic()-start,3)
    return result


def main(argv=None):
    parser = SafeParser(description=__doc__)
    sub = parser.add_subparsers(dest='action',required=True)
    sub.add_parser('show',help='Show proxy presence, never secrets; no network requests')
    diagnostic = sub.add_parser('check',help='Bounded DNS and TLS/HTTP check of an explicit URL')
    diagnostic.add_argument('url'); diagnostic.add_argument('--proxy')
    run = sub.add_parser('exec',help='Use an explicit HTTP(S) proxy for one command only')
    run.add_argument('--proxy',required=True);run.add_argument('command',nargs=argparse.REMAINDER)
    internal = sub.add_parser('_check',help=argparse.SUPPRESS);internal.add_argument('url')
    args = parser.parse_args(argv)
    try:
        if args.action=='show': print(json.dumps(inspect(os.environ)));return 0
        if args.action=='_check': print(json.dumps(check(args.url)));return 0
        if args.action=='exec':
            command = args.command[1:] if args.command[:1]==['--'] else args.command
            if not command: raise ValueError('A command is required after --')
            os.execvpe(command[0],command,proxy_environment(args.proxy,os.environ))
        url(args.url)
        env = proxy_environment(args.proxy,os.environ) if args.proxy else dict(os.environ)
        try:
            result = subprocess.run([sys.executable,str(Path(__file__).resolve()),'_check',args.url],env=env,capture_output=True,text=True,timeout=15)
            if result.returncode: raise ValueError('Diagnostic child failed (no credentials or response body printed)')
            print(result.stdout,end='');return 0 if json.loads(result.stdout)['http']['reachable'] else 1
        except subprocess.TimeoutExpired:
            print(json.dumps({'http':{'reachable':False},'error':'DNS/TLS/HTTP exceeded 15 seconds'}));return 1
    except (ValueError,OSError):
        print('gpuq-network: invalid URL/command or execution failed; no configuration was changed',file=sys.stderr)
        return 2

if __name__=='__main__':raise SystemExit(main())
